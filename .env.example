# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Path to the unzipped FreeSQL wallet folder (contains tnsnames.ora,
# sqlnet.ora, cwallet.sso, ewallet.p12, truststore.jks / truststore.pem).
TNS_ADMIN=

# TNS alias from <TNS_ADMIN>/tnsnames.ora whose entry uses PROTOCOL=TCPS.
ORACLE_TNS_ALIAS=26ai_un3c1_tcps

# FreeSQL schema user and password (do NOT hardcode these in source).
ORACLE_USER=
ORACLE_PASSWORD=
