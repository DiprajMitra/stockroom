# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# FreeSQL (Oracle 26ai) schema user and password.
ORACLE_USER=
ORACLE_PASSWORD=

# EZ connect string (simplest setup, no wallet needed).
# Format: tcps://<host>:<port>/<service_name>
# The default below is the public FreeSQL endpoint for the 26ai
# FreeSQL tier — change host/port/service if yours differs.
ORACLE_CONNECT_STRING=tcps://db.freesql.com:2484/26ai_un3c1

# Optional: TNS alias path.  Only set this if you want to use a
# FreeSQL wallet folder for cert pinning.  Leave both empty otherwise.
TNS_ADMIN=
ORACLE_TNS_ALIAS=
