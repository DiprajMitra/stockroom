# =============================================================
# .gitignore for the Inventory Control System (Node.js + Oracle)
# =============================================================

# -------------------------------------------------------------
# Node.js
# -------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
*.tgz

# npm / yarn / pnpm lockfiles - keep package-lock.json committed
# (uncomment if you prefer the alternative lockfile strategy)
# yarn.lock
# pnpm-lock.yaml

# -------------------------------------------------------------
# Environment variables and secrets
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.sso

# Oracle wallet files (DO NOT commit credentials)
cwallet.sso
ewallet.p12
wallet/
oracle_wallet/
tnsnames.ora
sqlnet.ora
ojdbc.properties

# -------------------------------------------------------------
# Logs
# -------------------------------------------------------------
logs/
*.log
*.log.*

# -------------------------------------------------------------
# Local scratch / temp files (development probes, output logs)
# -------------------------------------------------------------
_*.js
_*.out
_*.log

# -------------------------------------------------------------
# Operating system files
# -------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.DocumentRevisions-V100*
.fseventsd
.Spotlight-V100*
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.Trash-*

# -------------------------------------------------------------
# IDE and editor files
# -------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode-test/
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
.#*
.#*#

# -------------------------------------------------------------
# Miscellaneous
# -------------------------------------------------------------
# Coverage reports
coverage/
.nyc_output/

# Dependency directories (alternative package managers)
jspm_packages/
bower_components/

# Cache directories
.cache/
.parcel-cache/
.eslintcache

# TypeScript build info
*.tsbuildinfo
